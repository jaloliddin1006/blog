---
// A drawn arrow, not the ↗ character: the Latin font subset does not cover U+2197.
interface Props {
  direction?: 'up-right' | 'right';
}
const { direction = 'up-right' } = Astro.props;
---

<svg class:list={['ext-icon', direction]} viewBox="0 0 12 12" aria-hidden="true" focusable="false">
  {
    direction === 'up-right' ? (
      <path d="M3.5 8.5 8.5 3.5M4.4 3.5h4.1v4.1" />
    ) : (
      <path d="M2 6h7.2M6.4 3.2 9.2 6l-2.8 2.8" />
    )
  }
</svg>

<style>
  .ext-icon {
    /* Tailwind preflight makes every svg display:block — keep this one inline. */
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
    margin-inline-start: 0.15em;
    vertical-align: baseline;
  }
</style>
