---
import { profile } from '../lib/content';
import { hasPosts } from '../lib/posts';
import { LOCALES, localePath, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  route?: string;
  showBlogNav?: boolean;
}

const { locale, route = '', showBlogNav = false } = Astro.props;
const strings = t(locale);
const home = localePath(locale);
const blogLive = showBlogNav || (await hasPosts(locale));

const languages = LOCALES.map((code) => ({
  code,
  label: code.toUpperCase(),
  full: t(code).language[code],
  href: localePath(code, route),
  current: code === locale,
}));
---

<header class="site-header">
  <div class="bar glass glass-sheen">
    <a class="wordmark" href={home}>
      <span class="mark" aria-hidden="true"></span>
      {profile.wordmark}
    </a>

    <nav class="routes" aria-label={strings.nav.main}>
      {blogLive && <a href={localePath(locale, 'blog')}>{strings.nav.blog}</a>}
      <a href={localePath(locale, 'cv')}>{strings.nav.cv}</a>
    </nav>

    <div class="controls">
      <div class="langs" role="group" aria-label={strings.language.switch}>
        {
          languages.map((language) => (
            <a
              href={language.href}
              data-lang-link
              data-base={language.href}
              hreflang={language.code}
              lang={language.code}
              aria-current={language.current ? 'true' : undefined}
              title={language.full}
            >
              {language.label}
            </a>
          ))
        }
      </div>

      <button type="button" data-theme-toggle aria-label={strings.theme.toggle}>
        <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.4"></circle>
          <path
            d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"
          ></path>
        </svg>
        <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.3 8.3 0 1 0 10.5 10.5z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.remove('no-js');

    var toggle = document.querySelector('[data-theme-toggle]');
    if (toggle) {
      toggle.addEventListener('click', function () {
        var current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (error) {
          /* nothing to persist to */
        }
      });
    }

    // The language switch keeps the section anchor (SPEC A5).
    var links = document.querySelectorAll('a[data-lang-link]');
    var sync = function () {
      for (var i = 0; i < links.length; i++) {
        links[i].setAttribute('href', links[i].dataset.base + location.hash);
      }
    };
    if (links.length) {
      sync();
      window.addEventListener('hashchange', sync);
    }

    // The bar tightens once the page has moved.
    var header = document.querySelector('.site-header');
    if (header) {
      var onScroll = function () {
        header.classList.toggle('is-lifted', window.scrollY > 24);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0.75rem;
    left: 0;
    right: 0;
    z-index: 30;
    padding-inline: 0.75rem;
    display: flex;
    justify-content: center;
  }

  .bar {
    width: 100%;
    max-width: 1120px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem 0.55rem 1.1rem;
    border-radius: 999px;
    transition:
      box-shadow 0.4s ease,
      background-color 0.4s ease;
  }

  .site-header.is-lifted .bar {
    background-color: var(--glass-strong);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    margin-inline-end: auto;
  }

  .mark {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    flex: none;
  }

  .routes {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .routes a {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .routes a:hover {
    color: var(--accent);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-inline-start: 0.6rem;
    border-inline-start: 1px solid var(--glass-border);
  }

  .langs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
  }

  .langs a {
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.15rem 0.3rem;
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .langs a[aria-current='true'] {
    color: var(--on-accent);
    background-color: var(--accent);
  }

  .langs a:not([aria-current='true']):hover {
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  button[data-theme-toggle] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  button[data-theme-toggle]:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .icon {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .moon {
    display: none;
  }

  :root[data-theme='dark'] .sun {
    display: none;
  }

  :root[data-theme='dark'] .moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sun {
      display: none;
    }

    :root:not([data-theme='light']) .moon {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .site-header {
      padding-inline: 0.5rem;
    }

    .bar {
      gap: 0.5rem;
      padding: 0.5rem 0.6rem 0.5rem 0.8rem;
    }

    .wordmark {
      font-size: 0.8rem;
      gap: 0.4rem;
    }

    .mark {
      width: 7px;
      height: 7px;
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .routes {
      gap: 0.65rem;
    }

    .controls {
      gap: 0.4rem;
      padding-inline-start: 0.45rem;
    }

    .langs {
      gap: 0.15rem;
    }

    .langs a {
      padding: 0.15rem 0.25rem;
    }

    button[data-theme-toggle] {
      width: 27px;
      height: 27px;
    }
  }

  @media (max-width: 380px) {
    .wordmark {
      /* Below this the initials carry the mark; the full name would push the
         language switch off the bar. */
      font-size: 0;
      gap: 0;
    }

    .wordmark::after {
      content: 'JM';
      font-size: 0.85rem;
      margin-inline-start: 0.4rem;
    }
  }

  @media print {
    .site-header {
      display: none;
    }
  }
</style>
