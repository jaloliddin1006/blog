---
/**
 * The living backdrop: a point-globe of "data nodes" wired into a lattice,
 * rendered with Three.js and pinned behind every glass panel on the page.
 * It reads its colour from the theme tokens, follows the pointer, and stops
 * dead for anyone who asked for reduced motion.
 */
---

<canvas id="atlas" aria-hidden="true"></canvas>

<script>
  /*
   * Three.js is ~120 KB gzipped, so it is never part of the initial payload:
   * the module below is fetched only once we know the scene will actually run
   * — not for reduced motion, not on Save-Data, not without WebGL.
   */
  const canvas = document.getElementById('atlas') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;

  const supportsWebGl = () => {
    try {
      return Boolean(
        document.createElement('canvas').getContext('webgl2') ??
          document.createElement('canvas').getContext('webgl'),
      );
    } catch {
      return false;
    }
  };

  if (canvas && !reduced.matches && !saveData && supportsWebGl()) {
    const {
      BufferAttribute,
      BufferGeometry,
      Color,
      Group,
      LineBasicMaterial,
      LineSegments,
      PerspectiveCamera,
      Points,
      PointsMaterial,
      Scene,
      WebGLRenderer,
    } = await import('three');

    const small = window.matchMedia('(max-width: 767px)');

    const COUNT = small.matches ? 420 : 780;
    const RADIUS = 1;
    const LINK_DISTANCE = small.matches ? 0.2 : 0.155;
    const MAX_LINKS_PER_NODE = 2;

    /** Even distribution on a sphere — the Fibonacci lattice. */
    const positions = new Float32Array(COUNT * 3);
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < COUNT; i += 1) {
      const y = 1 - (i / (COUNT - 1)) * 2;
      const ring = Math.sqrt(Math.max(0, 1 - y * y));
      const theta = golden * i;
      positions[i * 3] = Math.cos(theta) * ring * RADIUS;
      positions[i * 3 + 1] = y * RADIUS;
      positions[i * 3 + 2] = Math.sin(theta) * ring * RADIUS;
    }

    // Wire each node to its nearest couple of neighbours: a lattice, not a mesh.
    const links: number[] = [];
    for (let i = 0; i < COUNT; i += 1) {
      const ax = positions[i * 3];
      const ay = positions[i * 3 + 1];
      const az = positions[i * 3 + 2];
      let made = 0;
      for (let j = i + 1; j < COUNT && made < MAX_LINKS_PER_NODE; j += 1) {
        const dx = ax - positions[j * 3];
        const dy = ay - positions[j * 3 + 1];
        const dz = az - positions[j * 3 + 2];
        if (dx * dx + dy * dy + dz * dz < LINK_DISTANCE * LINK_DISTANCE) {
          links.push(ax, ay, az, positions[j * 3], positions[j * 3 + 1], positions[j * 3 + 2]);
          made += 1;
        }
      }
    }

    const scene = new Scene();
    const camera = new PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(0, 0, 3.15);

    const globe = new Group();
    globe.rotation.z = -0.32;
    scene.add(globe);

    const pointGeometry = new BufferGeometry();
    pointGeometry.setAttribute('position', new BufferAttribute(positions, 3));
    const pointMaterial = new PointsMaterial({
      size: small.matches ? 0.019 : 0.016,
      sizeAttenuation: true,
      transparent: true,
      depthWrite: false,
    });
    globe.add(new Points(pointGeometry, pointMaterial));

    const lineGeometry = new BufferGeometry();
    lineGeometry.setAttribute('position', new BufferAttribute(new Float32Array(links), 3));
    const lineMaterial = new LineBasicMaterial({ transparent: true, depthWrite: false });
    globe.add(new LineSegments(lineGeometry, lineMaterial));

    const renderer = new WebGLRenderer({
      canvas,
      alpha: true,
      antialias: false,
      powerPreference: 'low-power',
    });
    renderer.setClearColor(0x000000, 0);

    let baseOpacity = 0.8;
    const readTheme = () => {
      const styles = getComputedStyle(document.documentElement);
      const node = styles.getPropertyValue('--particle').trim() || '#5fc0d2';
      const link = styles.getPropertyValue('--particle-dim').trim() || node;
      baseOpacity = Number.parseFloat(styles.getPropertyValue('--particle-opacity')) || 0.8;
      pointMaterial.color = new Color(node);
      lineMaterial.color = new Color(link);
    };
    readTheme();

    let baseScale = 1;
    const resize = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      // Off-centre on desktop, centred on mobile: the composition, not a logo.
      globe.position.x = width >= 1024 ? 0.95 : 0;
      globe.position.y = width >= 1024 ? 0.1 : 0.35;
      baseScale = width >= 1024 ? 1 : width >= 768 ? 0.88 : 0.72;
      camera.updateProjectionMatrix();
    };
    resize();

    const pointer = { x: 0, y: 0 };
    const eased = { x: 0, y: 0 };
    let scrollTilt = 0;
    let intro = 0;
    let frame = 0;
    let running = false;

    const draw = () => {
      // One cubic ease covers the whole entrance: it grows in and fades up.
      const ease = 1 - Math.pow(1 - Math.min(1, intro), 3);
      globe.scale.setScalar(baseScale * (0.88 + 0.12 * ease));
      eased.x += (pointer.x - eased.x) * 0.045;
      eased.y += (pointer.y - eased.y) * 0.045;
      globe.rotation.y += 0.0016;
      globe.rotation.x = eased.y * 0.24 + scrollTilt;
      globe.rotation.z = -0.32 + eased.x * 0.12;
      pointMaterial.opacity = baseOpacity * ease;
      lineMaterial.opacity = baseOpacity * 0.34 * ease;
      renderer.render(scene, camera);
    };

    const loop = () => {
      if (!running) return;
      intro = Math.min(1, intro + 0.02);
      draw();
      frame = requestAnimationFrame(loop);
    };

    const start = () => {
      if (running) return;
      running = true;
      frame = requestAnimationFrame(loop);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    start();

    window.addEventListener('resize', () => {
      resize();
      if (!running) draw();
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
        pointer.y = (event.clientY / window.innerHeight) * 2 - 1;
      },
      { passive: true },
    );

    window.addEventListener(
      'scroll',
      () => {
        const progress =
          window.scrollY / Math.max(1, document.body.scrollHeight - window.innerHeight);
        scrollTilt = progress * 0.55;
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    // Someone turning motion off mid-visit gets a still frame, immediately.
    reduced.addEventListener('change', (event) => {
      if (event.matches) {
        stop();
        intro = 1;
        draw();
      } else {
        start();
      }
    });

    // The globe follows the theme the moment it changes.
    new MutationObserver(() => {
      readTheme();
      if (!running) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readTheme();
      if (!running) draw();
    });
  }
</script>

<style>
  #atlas {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  @media print {
    #atlas {
      display: none;
    }
  }
</style>
