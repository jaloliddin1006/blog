---
import ExternalIcon from './ExternalIcon.astro';
import Shot from './Shot.astro';
import { hasProjectPage, type Project } from '../lib/content';
import { fill, localePath, pick, t, type Locale } from '../lib/i18n';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const strings = t(locale);
const detail = hasProjectPage(project, locale)
  ? localePath(locale, `projects/${project.slug}`)
  : null;
const cover = project.screenshots[0];
---

<li class="card glass glass-sheen">
  {
    cover && detail && (
      <a class="cover" href={detail} tabindex="-1" aria-hidden="true">
        <Shot
          slug={project.slug}
          shot={cover}
          locale={locale}
          sizes="(min-width: 768px) 340px, 92vw"
        />
      </a>
    )
  }

  <h3>
    {detail ? <a href={detail}>{project.name}</a> : project.name}
  </h3>

  <p class="description">{pick(project.description, locale)}</p>

  <ul class="chips">
    {project.stack.map((item) => <li>{item}</li>)}
  </ul>

  <p class="links">
    {
      detail && (
        <a class="detail" href={detail}>
          {strings.projects.detail}
          <ExternalIcon direction="right" />
        </a>
      )
    }
    <a
      href={project.repo}
      rel="noopener noreferrer"
      target="_blank"
      aria-label={fill(strings.projects.viewLabel, { name: project.name })}
    >
      {strings.projects.view}
      <ExternalIcon />
    </a>
  </p>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem 1.5rem;
    border-radius: 16px;
    transition:
      transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow:
      0 24px 48px -28px var(--accent-glow),
      var(--glass-shadow);
  }

  .cover {
    display: block;
    margin: -0.35rem 0 0.15rem;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    aspect-ratio: 16 / 10;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-meta);
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .description {
    margin: 0;
    font-size: var(--text-meta);
    color: var(--ink-2);
    flex: 1;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips li {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--accent);
    background-color: var(--accent-soft);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
  }

  .links a {
    font-size: var(--text-meta);
    color: var(--accent);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
