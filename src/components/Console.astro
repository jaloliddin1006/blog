---
/**
 * A query console over the site's own dataset.
 *
 * ⌘K, Ctrl+K or "/" opens it. Free text matches labels and tags; `type:`,
 * `stack:` and `year:` narrow it down. As you type, the background field
 * filters to the matching records — the results list and the field are two
 * views of the same query.
 */
import { buildRecords, postRecords, RECORD_TYPES } from '../lib/dataset';
import { getPosts } from '../lib/posts';
import { pick, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

/**
 * Every record is rendered here at build time and merely shown or hidden as you
 * type. Nothing is built from strings at runtime, scoped styles apply, and the
 * list is real HTML a screen reader can read.
 */
const records = [...buildRecords(), ...postRecords(await getPosts(locale), locale)]
  .sort((a, b) => RECORD_TYPES.indexOf(a.type) - RECORD_TYPES.indexOf(b.type))
  .map((record) => ({
    id: record.id,
    type: record.type,
    section: record.section,
    typeLabel: strings.console.types[record.type] ?? record.type,
    label: pick(record.label, locale),
    sub: pick(record.sub, locale),
    haystack:
      `${pick(record.label, locale)} ${pick(record.sub, locale)} ${record.type} ${record.tags.join(' ')}`.toLowerCase(),
    tags: record.tags.join(' '),
    year: record.year ?? '',
    href: record.href[locale],
    external: record.external ?? false,
  }));
---

<button class="trigger glass" type="button" data-console-open aria-haspopup="dialog">
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="7" cy="7" r="4.2"></circle>
    <path d="M10.2 10.2 14 14"></path>
  </svg>
  <span class="word">{strings.console.open}</span>
  <kbd>⌘K</kbd>
</button>

<div id="console" hidden>
  <div class="scrim" data-console-close></div>
  <div
    class="sheet glass glass-sheen"
    role="dialog"
    aria-modal="true"
    aria-label={strings.console.open}
  >
    <div class="field">
      <span class="prompt" aria-hidden="true">›</span>
      <input
        type="text"
        id="console-input"
        placeholder={strings.console.placeholder}
        autocomplete="off"
        spellcheck="false"
      />
      <output id="console-count" class="count"></output>
    </div>
    <ul id="console-results" role="listbox" aria-label={strings.console.open}>
      {
        records.map((record, index) => (
          <li
            role="option"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-index={index}
            data-type={record.type}
            data-section={record.section}
            data-year={record.year}
            data-tags={record.tags}
            data-haystack={record.haystack}
            data-href={record.href}
            data-id={record.id}
            data-external={record.external ? 'true' : 'false'}
          >
            <span class="type">{record.typeLabel}</span>
            <span class="label">{record.label}</span>
            <span class="sub">{record.sub}</span>
          </li>
        ))
      }
      <li class="empty" hidden>{strings.console.empty}</li>
    </ul>
    <p class="hint">{strings.console.hint}</p>
  </div>
</div>

<script
  id="console-strings"
  type="application/json"
  is:inline
  set:html={JSON.stringify(strings.console)}
/>

<script>
  const root = document.getElementById('console');
  const input = document.getElementById('console-input') as HTMLInputElement | null;
  const list = document.getElementById('console-results');
  const count = document.getElementById('console-count');
  const strings = JSON.parse(document.getElementById('console-strings')?.textContent ?? '{}');

  if (root && input && list && count) {
    const dialog = root;
    const search = input;
    const counter = count;
    const rows = Array.from(list.querySelectorAll<HTMLLIElement>('li[data-index]'));
    const empty = list.querySelector<HTMLLIElement>('li.empty');

    const lock = (locked: boolean) =>
      window.dispatchEvent(new CustomEvent('atlas:lock', { detail: locked }));

    let visible: HTMLLIElement[] = rows;
    let active = 0;

    /** `field:value` pairs, plus whatever free text is left over. */
    function parse(query: string) {
      const filters: [string, string][] = [];
      const text = query
        .replace(/(\w+):([^\s]+)/g, (_, key: string, value: string) => {
          filters.push([key.toLowerCase(), value.toLowerCase()]);
          return ' ';
        })
        .trim()
        .toLowerCase();
      return { filters, terms: text.split(/\s+/).filter(Boolean) };
    }

    function matches(row: HTMLLIElement, terms: string[], filters: [string, string][]) {
      const haystack = row.dataset.haystack ?? '';
      for (const term of terms) {
        if (!haystack.includes(term)) return false;
      }
      for (const [key, value] of filters) {
        const hit =
          key === 'type'
            ? (row.dataset.type ?? '').startsWith(value)
            : key === 'year'
              ? (row.dataset.year ?? '').includes(value)
              : key === 'stack' || key === 'tag'
                ? (row.dataset.tags ?? '').includes(value)
                : haystack.includes(value);
        if (!hit) return false;
      }
      return true;
    }

    function run(query: string) {
      const started = performance.now();
      const { filters, terms } = parse(query);
      const narrowed = terms.length > 0 || filters.length > 0;

      visible = [];
      for (const row of rows) {
        const shown = !narrowed || matches(row, terms, filters);
        row.hidden = !shown;
        if (shown) visible.push(row);
      }

      if (empty) empty.hidden = visible.length > 0;
      active = 0;

      const elapsed = Math.max(0.1, performance.now() - started);
      counter.textContent = narrowed
        ? `${visible.length} ${strings.rows} · ${elapsed.toFixed(1)} ms`
        : `${rows.length} ${strings.rows}`;

      markActive();
      window.atlas?.highlight(narrowed ? visible.map((row) => row.dataset.id ?? '') : null);
    }

    function markActive() {
      rows.forEach((row) => row.setAttribute('aria-selected', 'false'));
      const row = visible[active];
      if (!row) return;
      row.setAttribute('aria-selected', 'true');
      row.scrollIntoView({ block: 'nearest' });
      if (search.value.trim()) window.atlas?.highlight([row.dataset.id ?? '']);
    }

    function open(row: HTMLLIElement) {
      const href = row.dataset.href;
      if (!href) return;
      close();
      if (row.dataset.external === 'true') window.open(href, '_blank', 'noopener');
      else window.location.href = href;
    }

    function show() {
      dialog.hidden = false;
      lock(true);
      search.value = '';
      run('');
      search.focus();
      window.atlas?.highlight(null);
    }

    function close() {
      dialog.hidden = true;
      lock(false);
      window.atlas?.highlight(null);
    }

    rows.forEach((row) => {
      row.addEventListener('click', () => open(row));
      row.addEventListener('mousemove', () => {
        const index = visible.indexOf(row);
        if (index >= 0 && index !== active) {
          active = index;
          markActive();
        }
      });
    });

    document
      .querySelectorAll('[data-console-open]')
      .forEach((button) => button.addEventListener('click', show));
    document
      .querySelectorAll('[data-console-close]')
      .forEach((node) => node.addEventListener('click', close));

    search.addEventListener('input', () => run(search.value));

    search.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        active = Math.min(visible.length - 1, active + 1);
        markActive();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        active = Math.max(0, active - 1);
        markActive();
      } else if (event.key === 'Enter' && visible[active]) {
        event.preventDefault();
        open(visible[active]);
      } else if (event.key === 'Escape') {
        close();
      }
    });

    window.addEventListener('keydown', (event) => {
      const typing =
        event.target instanceof HTMLElement &&
        ['INPUT', 'TEXTAREA', 'SELECT'].includes(event.target.tagName);
      if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        if (dialog.hidden) show();
        else close();
      } else if (event.key === '/' && !typing && dialog.hidden) {
        event.preventDefault();
        show();
      } else if (event.key === 'Escape' && !dialog.hidden) {
        close();
      }
    });
  }
</script>

<style>
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.55rem 0.3rem 0.6rem;
    border-radius: 999px;
    background-color: transparent;
    box-shadow: none;
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
  }

  .trigger:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .trigger svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .word {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-2);
    border: 1px solid var(--glass-border);
    border-radius: 5px;
    padding: 0.05rem 0.3rem;
  }

  #console {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    align-items: start;
    justify-items: center;
    padding: 12vh 1rem 1rem;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background-color: var(--scrim);
    backdrop-filter: blur(4px);
  }

  .sheet {
    position: relative;
    background-color: var(--surface);
    width: min(640px, 100%);
    max-height: 70vh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    border-radius: 18px;
    overflow: hidden;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .prompt {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  #console-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }

  #console-input:focus {
    outline: none;
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-2);
    white-space: nowrap;
  }

  #console-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-y: auto;
  }

  #console-results li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    grid-template-areas: 'type label' 'type sub';
    gap: 0 0.75rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    cursor: pointer;
  }

  #console-results li[aria-selected='true'] {
    background-color: var(--accent-soft);
  }

  #console-results .type {
    grid-area: type;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  #console-results .label {
    grid-area: label;
    font-size: var(--text-meta);
    color: var(--ink);
  }

  #console-results .sub {
    grid-area: sub;
    font-size: var(--text-micro);
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #console-results .empty {
    display: block;
    padding: 1.25rem 0.7rem;
    font-size: var(--text-meta);
    color: var(--ink-2);
  }

  .hint {
    margin: 0;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--glass-border);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-2);
  }

  @media (max-width: 600px) {
    .word,
    kbd {
      display: none;
    }

    .trigger {
      padding: 0.35rem;
    }

    #console {
      padding-top: 6vh;
    }

    #console-results li {
      grid-template-columns: 1fr;
      grid-template-areas: 'type' 'label' 'sub';
      gap: 0.1rem;
    }
  }

  @media print {
    .trigger,
    #console {
      display: none;
    }
  }
</style>
