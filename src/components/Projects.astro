---
import ExternalIcon from './ExternalIcon.astro';
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import { featuredProjects, profile } from '../lib/content';
import { localePath, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<Section id="projects" index="03" title={strings.sections.projects} wide>
  <ul class="grid stagger">
    {featuredProjects.map((project) => <ProjectCard project={project} locale={locale} />)}
  </ul>

  <p class="all">
    <a href={localePath(locale, 'projects')}>
      {strings.projects.allProjects}<ExternalIcon direction="right" />
    </a>
    <a href={profile.links.github} rel="noopener noreferrer" target="_blank">
      {strings.projects.all}<ExternalIcon />
    </a>
  </p>
</Section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .all {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
  }

  .all a {
    font-size: var(--text-meta);
    color: var(--accent);
    text-decoration: none;
  }

  .all a:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
