---
import ExternalIcon from './ExternalIcon.astro';
import Section from './Section.astro';
import { featuredProjects, profile } from '../lib/content';
import { fill, pick, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<Section id="projects" index="03" title={strings.sections.projects} wide>
  <ul class="grid stagger">
    {
      featuredProjects.map((project) => (
        <li class="card glass glass-sheen">
          <h3>{project.name}</h3>
          <p class="description">{pick(project.description, locale)}</p>
          <ul class="chips">
            {project.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class="repo"
            href={project.url}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={fill(strings.projects.viewLabel, { name: project.name })}
          >
            {strings.projects.view}
            <ExternalIcon />
          </a>
        </li>
      ))
    }
  </ul>

  <p class="all">
    <a href={profile.links.github} rel="noopener noreferrer" target="_blank">
      {strings.projects.all}<ExternalIcon />
    </a>
  </p>
</Section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem 1.5rem;
    border-radius: 16px;
    transition:
      transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow:
      0 24px 48px -28px var(--accent-glow),
      var(--glass-shadow);
  }

  h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-meta);
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .description {
    margin: 0;
    font-size: var(--text-meta);
    color: var(--ink-2);
    flex: 1;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips li {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--accent);
    background-color: var(--accent-soft);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .repo {
    font-size: var(--text-meta);
    color: var(--accent);
    text-decoration: none;
    align-self: flex-start;
  }

  .repo:hover {
    text-decoration: underline;
  }

  .all {
    margin: 1.5rem 0 0;
  }

  .all a {
    font-size: var(--text-meta);
    color: var(--accent);
    text-decoration: none;
  }

  .all a:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
