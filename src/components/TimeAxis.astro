---
/**
 * The work history as a table-chart: name · span · period.
 *
 * A list can state that two roles overlapped; only a time axis can show it.
 * Each row carries its own label, so the chart reads on its own — the bars are
 * positioned as percentages of the full range rather than on a shared month
 * grid, which keeps the label column independent and the whole thing fluid.
 */
import { experience } from '../lib/content';
import { pick, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const toMonths = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return year * 12 + (month - 1);
};

const now = new Date();
const today = now.getUTCFullYear() * 12 + now.getUTCMonth();

const starts = experience.map((entry) => toMonths(entry.start));
const ends = experience.map((entry) => (entry.end ? toMonths(entry.end) : today));
const first = Math.min(...starts);
const last = Math.max(...ends, today);
// A month of air on each side so the first and last bars are not flush.
const from = first - 1;
const span = last - from + 2;
const percent = (month: number) => ((month - from) / span) * 100;

const rows = experience.map((entry, index) => ({
  id: entry.id,
  name: pick(entry.short, locale),
  full: pick(entry.role, locale),
  period: pick(entry.period, locale),
  secondary: Boolean(entry.secondary),
  current: !entry.end,
  left: percent(starts[index]),
  width: percent(ends[index]) - percent(starts[index]),
  months: ends[index] - starts[index],
}));

const years: { year: number; left: number }[] = [];
for (let month = from; month <= from + span; month += 1) {
  if (month % 12 === 0) years.push({ year: month / 12, left: percent(month) });
}
---

<figure class="axis">
  <figcaption class="sr-only">
    {rows.map((row) => `${row.full}: ${row.period}. `).join('')}
  </figcaption>

  <div class="chart">
    <div class="scale" aria-hidden="true">
      {
        years.map((tick) => (
          <span class="year" style={`left: ${tick.left}%`}>
            {tick.year}
          </span>
        ))
      }
    </div>

    <div class="rows">
      <div class="lines" aria-hidden="true">
        {years.map((tick) => <span class="line" style={`left: ${tick.left}%`} />)}
        <span class="line today" style={`left: ${percent(today)}%`}></span>
      </div>

      {
        rows.map((row) => (
          <div class="row" data-span={row.id}>
            <span class="name">{row.name}</span>
            <span class="track">
              <button
                type="button"
                class:list={['bar', { secondary: row.secondary, current: row.current }]}
                style={`left: ${row.left}%; width: ${row.width}%`}
                title={`${row.full} · ${row.period}`}
                aria-label={`${row.full} · ${row.period}`}
              />
            </span>
            <span class="period">{row.period}</span>
          </div>
        ))
      }
    </div>
  </div>
</figure>

<script>
  // Hovering a span lights its written entry and its record in the background
  // field; the list below stays the accessible source of truth.
  const rows = document.querySelectorAll<HTMLElement>('.row[data-span]');

  const setActive = (id: string | null) => {
    document.querySelectorAll<HTMLElement>('[data-entry]').forEach((entry) => {
      entry.classList.toggle('is-active', entry.dataset.entry === id);
    });
    rows.forEach((row) => row.classList.toggle('is-active', row.dataset.span === id));
    window.atlas?.highlight(id ? [`role:${id}`] : null);
  };

  rows.forEach((row) => {
    const id = row.dataset.span ?? null;
    row.addEventListener('mouseenter', () => setActive(id));
    row.addEventListener('mouseleave', () => setActive(null));
    row.querySelector('button')?.addEventListener('focus', () => setActive(id));
    row.querySelector('button')?.addEventListener('blur', () => setActive(null));
    row.querySelector('button')?.addEventListener('click', () => {
      document
        .querySelector(`[data-entry="${id}"]`)
        ?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  });
</script>

<style>
  .axis {
    margin: 0 0 2.75rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .chart {
    --label: 12rem;
    --period: 10rem;
  }

  .scale {
    position: relative;
    height: 1.25rem;
    margin-inline-start: var(--label);
    margin-inline-end: var(--period);
  }

  .year {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-2);
  }

  .rows {
    position: relative;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .lines {
    position: absolute;
    inset: 0;
    margin-inline-start: var(--label);
    margin-inline-end: var(--period);
    pointer-events: none;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--glass-border);
  }

  .line.today {
    background: none;
    border-left: 1px dashed var(--accent);
    opacity: 0.7;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr) var(--period);
    align-items: center;
    gap: 0 0.75rem;
    padding-block: 0.45rem;
  }

  .row + .row {
    border-top: 1px solid color-mix(in srgb, var(--glass-border) 55%, transparent);
  }

  .row.is-active {
    background-color: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }

  .name,
  .period {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .name {
    color: var(--ink);
    padding-inline-start: 0.15rem;
  }

  .period {
    color: var(--ink-2);
    text-align: end;
    padding-inline-end: 0.15rem;
  }

  .track {
    position: relative;
    display: block;
    height: 0.85rem;
  }

  .bar {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 6px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--accent) 45%, transparent);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .bar.secondary {
    background-color: color-mix(in srgb, var(--ink-2) 40%, transparent);
  }

  .bar.current {
    background-color: var(--accent);
  }

  .row:hover .bar,
  .row.is-active .bar,
  .bar:focus-visible {
    background-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  @media (max-width: 1023px) {
    .chart {
      --period: 0rem;
    }

    .period {
      display: none;
    }
  }

  /* Below this a three-year axis cannot carry labels; the list does the work. */
  @media (max-width: 767px) {
    .axis {
      display: none;
    }
  }

  @media print {
    .axis {
      display: none;
    }
  }
</style>
