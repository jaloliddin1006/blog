---
import Base from '../layouts/Base.astro';
import { LOCALES, localePath, t } from '../lib/i18n';

const locale = 'en' as const;
const strings = t(locale);
---

<Base
  locale={locale}
  title={strings.meta.notFoundTitle}
  description={strings.notFound.body}
  route=""
  noindex
>
  <div class="not-found shell">
    <p class="code">404</p>
    <h1>{strings.notFound.title}</h1>
    <p class="body measure">{strings.notFound.body}</p>
    <ul class="homes">
      {
        LOCALES.map((code) => (
          <li>
            <a href={localePath(code)} lang={code} hreflang={code}>
              {t(code).notFound.home}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .not-found {
    padding-block: 8rem 5rem;
  }

  .code {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-2);
  }

  h1 {
    margin: 0 0 1rem;
    font-size: var(--text-h1);
  }

  .body {
    margin: 0 0 2rem;
    color: var(--ink-2);
  }

  .homes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .homes a {
    font-size: var(--text-meta);
    color: var(--accent);
    text-decoration: none;
  }

  .homes a:hover {
    text-decoration: underline;
  }
</style>
